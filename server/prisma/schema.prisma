// ============================================================================
//  Prisma schema — Bali Home
//  Đổi schema xong chạy: npm run db:migrate   (tạo migration + cập nhật client)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique // luôn lưu dạng chữ thường
  fullName     String    @map("full_name")
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(USER)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  contactRequests ContactRequest[]

  @@map("users")
}

enum ContactStatus {
  NEW       // mới gửi, chưa ai xử lý
  CONTACTED // đã gọi lại
  DONE      // đã xong
}

// Yêu cầu tư vấn gửi từ form "Liên hệ" trên trang chủ (khách hoặc thành viên)
model ContactRequest {
  id        String        @id @default(uuid()) @db.Uuid
  fullName  String        @map("full_name")
  phone     String
  email     String?
  need      String        // products | installation | maintenance | other
  message   String?
  status    ContactStatus @default(NEW)
  userId    String?       @map("user_id") @db.Uuid // có nếu người gửi đang đăng nhập
  ip        String?
  createdAt DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_requests")
}

// Mỗi lần đăng nhập trên 1 thiết bị = 1 session.
// Chỉ lưu SHA-256 của refresh token → lộ DB cũng không dùng được token.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  persistent Boolean   @default(false) // "Ghi nhớ đăng nhập"
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
