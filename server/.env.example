# Sao chép thành .env rồi chỉnh giá trị
NODE_ENV=development
PORT=4000

# Khớp với docker-compose.yml ở thư mục gốc
DATABASE_URL="postgresql://bali:bali_dev_password@localhost:5432/balihome?schema=public"

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

CLIENT_ORIGIN=http://localhost:5173

# Cloudinary — lưu file đính kèm (form báo giá). Lấy ở cloudinary.com → Dashboard → API Keys.
# Bỏ trống → tính năng tải tệp tự tắt, các chức năng khác vẫn chạy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Số proxy đứng trước app. Dev: loopback (Vite). Render: 1
TRUST_PROXY=loopback
