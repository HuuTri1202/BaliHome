// ============================================================================
//  Prisma schema — Bali Home
//  Đổi schema xong chạy: npm run db:migrate   (tạo migration + cập nhật client)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique // luôn lưu dạng chữ thường
  fullName     String    @map("full_name")
  phone        String?   @unique
  passwordHash String?   @map("password_hash") // NULL: tài khoản tạo từ Google/Facebook, chưa đặt mật khẩu
  role         Role      @default(USER)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  contactRequests ContactRequest[]
  authoredEvents  RequestEvent[]   @relation("EventAuthor")
  notifications   Notification[]
  identities      AuthIdentity[]

  @@map("users")
}

// Đăng nhập bằng tài khoản bên ngoài: mỗi nhà cung cấp (google, facebook) tối đa 1 liên kết / tài khoản
model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String // google | facebook
  providerUserId String   @map("provider_user_id") // "sub" (Google) / id (Facebook)
  email          String? // email nhà cung cấp xác nhận; NULL = khách tự nhập (chưa xác minh)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("auth_identities")
}

// Dịch vụ Bali Home cung cấp. Nội dung sửa trực tiếp trong DB (sau này: trang quản trị).
model Service {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique // dùng trong URL: /dich-vu/<slug>
  name         String
  group        String   // creative | digital | growth — nhóm hiển thị
  tagline      String   // 1 câu ngắn
  summary      String   // đoạn giới thiệu
  deliverables String[] // "Bạn nhận được"
  idealFor     String[] @map("ideal_for") // "Phù hợp khi"
  process      Json     @default("[]") // Quy trình riêng: [{ "title": "...", "text": "..." }]
  faqs         Json     @default("[]") // Câu hỏi thường gặp: [{ "q": "...", "a": "..." }]
  priceFrom    Int?     @map("price_from") // VND; null = báo giá theo yêu cầu
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("services")
}

enum ContactStatus {
  NEW         // Mới tiếp nhận
  CONTACTED   // Đã liên hệ
  IN_PROGRESS // Đang xử lý
  DONE        // Hoàn thành
  CANCELLED   // Đã huỷ
}

// Yêu cầu tư vấn / báo giá (form nhanh ở trang chủ hoặc form nhiều bước /bao-gia)
model ContactRequest {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique // mã khách đọc khi gọi hotline, vd. BLH-2026-8921
  fullName  String        @map("full_name")
  phone     String
  email     String?
  company   String?
  need      String        // slug của Service, hoặc "other"
  industry  String?       // lĩnh vực kinh doanh của khách
  budget    String?       // khoảng ngân sách (khoá, xem validators/contact.schema.js)
  deadline  DateTime?     // ngày mong muốn hoàn thành
  message   String?
  status    ContactStatus @default(NEW)
  userId    String?       @map("user_id") @db.Uuid // có nếu người gửi đang đăng nhập
  ip        String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  events      RequestEvent[]
  attachments Attachment[]
  notifications Notification[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("contact_requests")
}

// Dòng thời gian của 1 yêu cầu: tạo mới, đổi trạng thái, ghi chú gửi khách
model RequestEvent {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  kind       String         // created | status | edited | note (tin nhắn của Bali Home) | message (tin nhắn của khách)
  fromStatus ContactStatus? @map("from_status")
  toStatus   ContactStatus? @map("to_status")
  note       String?        // khách NHÌN THẤY ghi chú này
  authorId   String?        @map("author_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  request     ContactRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      User?          @relation("EventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([requestId, createdAt])
  @@index([kind, requestId, createdAt])
  @@map("request_events")
}

// Thông báo Bali Home gửi cho khách khi có cập nhật về yêu cầu của họ
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  requestId String?   @map("request_id") @db.Uuid
  kind      String    @default("status") // message (tin nhắn của Bali Home) | status (đổi trạng thái)
  title     String
  body      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ContactRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// Tệp đính kèm của yêu cầu — file nằm trên Cloudinary, DB chỉ lưu đường dẫn
model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid // có nếu tệp được gửi kèm một tin nhắn
  url       String
  publicId  String   @map("public_id")
  fileName  String   @map("file_name")
  bytes     Int
  format    String?
  createdAt DateTime @default(now()) @map("created_at")

  request ContactRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  event   RequestEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([eventId])
  @@map("attachments")
}

// Mỗi lần đăng nhập trên 1 thiết bị = 1 session.
// Chỉ lưu SHA-256 của refresh token → lộ DB cũng không dùng được token.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  persistent Boolean   @default(false) // "Ghi nhớ đăng nhập"
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
